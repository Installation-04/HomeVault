# Copy to .env and adjust before running `docker compose up -d`.

# Host port to publish the app on (container always listens on 4000).
HOST_PORT=8080

# --- Backend runtime config (see backend/.env.example for details) ---
NODE_ENV=production
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# These paths are inside the container; the docker-compose volume maps
# ./data on the host (your NAS mount) to /app/backend/data.
DB_PATH=./data/homevault.sqlite
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
BACKUP_CRON=0 3 * * *
REMINDER_CHECK_CRON=0 8 * * *

# Optional SMTP for email reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homevault@example.com

# Frontend is served by the same container, so this rarely needs changing.
CORS_ORIGIN=http://localhost:8080

DEFAULT_LOCALE=en
