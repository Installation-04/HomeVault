# HomeVault configuration. `./deploy.sh install` creates .env from this file and
# fills in the secrets for you. Edit .env, never this example.

# ---- Secrets (generated by deploy.sh; keep a copy in your password manager) ----

# REQUIRED. Signs short-lived login challenges. The app refuses to start in
# production with a missing, placeholder or short value. Generate: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Encrypts two-factor secrets in the database. Separate from APP_SECRET so that
# rotating APP_SECRET doesn't lock people out of 2FA. LOSING THIS MEANS 2FA
# secrets in a restored backup can't be read (an admin can reset them).
# Generate: openssl rand -hex 32
DATA_KEY=

# While set, creating the first admin account requires this token, so nobody who
# stumbles on a fresh instance can claim it. Printed by deploy.sh; you can unset it afterwards.
SETUP_TOKEN=

# ---- Network ----
HOST_PORT=8080
# 0.0.0.0 = reachable from your LAN. 127.0.0.1 = only via a reverse proxy on this machine.
BIND_ADDRESS=0.0.0.0

# Automatic HTTPS (Let's Encrypt via Caddy): set by `./deploy.sh install --domain example.com`.
# Needs DNS pointing here and ports 80/443 reachable.
DOMAIN=

# Number of reverse proxies in front of the app (1 for Caddy/Traefik/Nginx; empty when
# you connect directly). Needed so rate limiting and the audit log see real client IPs.
TRUST_PROXY=

# auto = Secure cookies when the request arrived over HTTPS; always / never to force.
COOKIE_SECURE=auto
# true = send HSTS and always use Secure cookies. Only enable once HTTPS works for good.
FORCE_HTTPS=false

# ---- Storage (paths inside the container; DATA_DIR is the host folder mounted there) ----
DATA_DIR=./data
DB_PATH=./data/homevault.sqlite
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# ---- Behaviour ----
NODE_ENV=production
PORT=4000
DEFAULT_LOCALE=en

# Sign-in sessions: absolute lifetime and idle timeout, in days.
SESSION_DAYS=30
SESSION_IDLE_DAYS=14
# Failed sign-ins allowed per address per 15 minutes (each account also has its own limit).
LOGIN_RATE_LIMIT=20

# Nightly database snapshots (cron syntax) and how many to keep.
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=14
# Days of security audit history to keep.
AUDIT_RETENTION_DAYS=400

# Reminder emails (cron) and how many days ahead to warn about expiring documents / warranties (0 = off).
REMINDER_CHECK_CRON=0 8 * * *
EXPIRY_NOTICE_DAYS=30

# Optional SMTP for email reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homevault@example.com

# ---- Container image ----
# Use a prebuilt image instead of building locally:  ./deploy.sh install --image ghcr.io/installation-04/homevault:latest
HOMEVAULT_IMAGE=homevault:latest
HOMEVAULT_MEMORY=768m
