# Copy to .env and adjust before running `docker compose up -d`.

# Host port to publish the app on (container always listens on 4000).
HOST_PORT=8080

# --- Backend runtime config (see backend/.env.example for details) ---
NODE_ENV=production
PORT=4000
# REQUIRED. The app refuses to start in production with the placeholder below.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# These paths are inside the container; the docker-compose volume maps
# ./data on the host (your NAS mount) to /app/backend/data.
DB_PATH=./data/homevault.sqlite
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
BACKUP_CRON=0 3 * * *
REMINDER_CHECK_CRON=0 8 * * *

# Optional SMTP for email reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homevault@example.com

# Frontend is served by the same container, so this rarely needs changing.
CORS_ORIGIN=http://localhost:8080

# Behind a reverse proxy (Traefik/Nginx/Caddy)? Set the number of proxies in
# front of the app (usually 1) so login rate limiting sees real client IPs.
# TRUST_PROXY=1

# Failed logins allowed per IP per 15 minutes before a temporary lockout.
# LOGIN_RATE_LIMIT=10

# Email a heads-up this many days before a document expires or an equipment
# warranty ends (0 disables). Reminders use their own per-reminder lead time.
# EXPIRY_NOTICE_DAYS=30

DEFAULT_LOCALE=en
