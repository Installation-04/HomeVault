# Server
PORT=4000
NODE_ENV=production
# Required in production (the app refuses to start with the placeholder).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Database (SQLite by default). Point DB_PATH at your NAS volume mount.
DB_PATH=./data/homevault.sqlite

# File storage (documents, photos). Point at your NAS volume mount.
UPLOAD_DIR=./data/uploads

# Backups
BACKUP_DIR=./data/backups
BACKUP_CRON=0 3 * * *

# Reminder engine
REMINDER_CHECK_CRON=0 8 * * *

# Optional email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homevault@example.com

# CORS - frontend origin(s), comma separated
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (so rate limiting sees real IPs)
# TRUST_PROXY=1

# Failed logins allowed per IP per 15 minutes
# LOGIN_RATE_LIMIT=10

# Days before a document expiry / warranty end to send an email notice (0 = off)
# EXPIRY_NOTICE_DAYS=30

# Default UI language: en or fr
DEFAULT_LOCALE=en
