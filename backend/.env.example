# Server
PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# Database (SQLite by default). Point DB_PATH at your NAS volume mount.
DB_PATH=./data/homevault.sqlite

# File storage (documents, photos). Point at your NAS volume mount.
UPLOAD_DIR=./data/uploads

# Backups
BACKUP_DIR=./data/backups
BACKUP_CRON=0 3 * * *

# Reminder engine
REMINDER_CHECK_CRON=0 8 * * *

# Optional email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homevault@example.com

# CORS - frontend origin(s), comma separated
CORS_ORIGIN=http://localhost:5173

# Default UI language: en or fr
DEFAULT_LOCALE=en
