# Local development (npm run dev). For Docker deployment use the root .env.example
# via ./deploy.sh instead.

PORT=4000
NODE_ENV=development

# Optional in development (a random one is used per run). REQUIRED in production.
# Generate one with:  openssl rand -hex 32
APP_SECRET=
DATA_KEY=
# SETUP_TOKEN=

DB_PATH=./data/homevault.sqlite
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=14
REMINDER_CHECK_CRON=0 8 * * *

# Behind a reverse proxy, the number of proxies in front of the app.
# TRUST_PROXY=1
# COOKIE_SECURE=auto
# FORCE_HTTPS=false

# Failed logins allowed per address per 15 minutes.
# LOGIN_RATE_LIMIT=20
# SESSION_DAYS=30
# SESSION_IDLE_DAYS=14
# EXPIRY_NOTICE_DAYS=30
# AUDIT_RETENTION_DAYS=400

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homevault@example.com
DEFAULT_LOCALE=en
